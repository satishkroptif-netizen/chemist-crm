# Copy to .env and fill in real values before deploying

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=chemist_crm

# Backend security
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
DEBUG=false

# CORS - comma-separated, no spaces. Example:
# BACKEND_CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
BACKEND_CORS_ORIGINS=https://yourdomain.com

# Frontend API URL (public URL of your backend)
VITE_API_URL=https://api.yourdomain.com/api/v1
