# Production environment for split deployment
# Copy to frontend/.env.production and backend/.env

# ============================================
# FRONTEND (Vercel) - frontend/.env.production
# ============================================
VITE_API_URL=https://your-backend-url.onrender.com/api/v1

# ============================================
# BACKEND (PythonAnywhere / Koyeb / Railway) - backend/.env
# ============================================
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
REDIS_URL=redis://host:6379/0
SECRET_KEY=your-long-random-secret-key-min-32-chars
DEBUG=false
BACKEND_CORS_ORIGINS=https://your-vercel-app.vercel.app
